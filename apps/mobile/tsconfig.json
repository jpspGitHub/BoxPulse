{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["react"]
  },
  "include": [
    "App.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "constants/**/*.ts",
    "env.d.ts",
    "index.ts",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "mocks/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "types/**/*.ts"
  ]
}
